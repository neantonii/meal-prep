{
  "$defs": {
    "RecipeCategory": {
      "enum": [
        "modular_protein",
        "modular_carb",
        "modular_cooked_veg",
        "fresh_salad_veg",
        "breakfast"
      ],
      "title": "RecipeCategory",
      "type": "string"
    },
    "RecipeCookwareRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Equipment identifier or canonical name",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RecipeCookwareRef",
      "type": "object"
    },
    "RecipeIngredientMention": {
      "additionalProperties": false,
      "description": "An amount-less ingredient reference (``@name`` or ``@name{}``).\n\nCarries only an id. A mention contributes nothing to quantity and must be\nbacked by a declaration elsewhere in the recipe; the recipe service enforces\nthat invariant.",
      "properties": {
        "id": {
          "description": "Ingredient identifier matching catalog id",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RecipeIngredientMention",
      "type": "object"
    },
    "RecipeIngredientRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Ingredient identifier matching catalog id",
          "title": "Id",
          "type": "string"
        },
        "quantity": {
          "description": "Quantity used in recipe",
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "unit": {
          "default": "",
          "description": "Measurement unit; empty string means a count (resolved to the reserved 'count' node during enrichment).",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "quantity"
      ],
      "title": "RecipeIngredientRef",
      "type": "object"
    },
    "RecipeStorage": {
      "additionalProperties": false,
      "properties": {
        "freezer_friendly": {
          "description": "Whether the cooked batch can be frozen",
          "title": "Freezer Friendly",
          "type": "boolean"
        },
        "fridge_days": {
          "description": "Maximum safe refrigerated shelf life in days",
          "exclusiveMinimum": 0,
          "title": "Fridge Days",
          "type": "integer"
        }
      },
      "required": [
        "fridge_days",
        "freezer_friendly"
      ],
      "title": "RecipeStorage",
      "type": "object"
    },
    "RecipeYield": {
      "additionalProperties": false,
      "properties": {
        "cooked_g": {
          "description": "Total finished cooked batch weight in grams",
          "exclusiveMinimum": 0,
          "title": "Cooked G",
          "type": "number"
        },
        "servings": {
          "description": "Number of portions produced by the batch",
          "exclusiveMinimum": 0,
          "title": "Servings",
          "type": "number"
        }
      },
      "required": [
        "servings",
        "cooked_g"
      ],
      "title": "RecipeYield",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "$ref": "#/$defs/RecipeCategory"
    },
    "cookware": {
      "items": {
        "$ref": "#/$defs/RecipeCookwareRef"
      },
      "title": "Cookware",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "ingredients": {
      "items": {
        "$ref": "#/$defs/RecipeIngredientRef"
      },
      "title": "Ingredients",
      "type": "array"
    },
    "instructions": {
      "title": "Instructions",
      "type": "string"
    },
    "mentions": {
      "description": "Amount-less ingredient references",
      "items": {
        "$ref": "#/$defs/RecipeIngredientMention"
      },
      "title": "Mentions",
      "type": "array"
    },
    "source_path": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Path"
    },
    "storage": {
      "$ref": "#/$defs/RecipeStorage"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "yield": {
      "$ref": "#/$defs/RecipeYield"
    }
  },
  "required": [
    "id",
    "title",
    "category",
    "yield",
    "storage",
    "ingredients",
    "cookware",
    "instructions"
  ],
  "title": "RecipeDTO",
  "type": "object"
}
