{
  "$defs": {
    "DiaryDayDTO": {
      "additionalProperties": false,
      "properties": {
        "breakfast": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DiaryEntryDTO"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Breakfast entries in eaten order",
          "title": "Breakfast"
        },
        "date": {
          "description": "Calendar day this entry records",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "dinner": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DiaryEntryDTO"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dinner entries in eaten order",
          "title": "Dinner"
        },
        "lunch": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DiaryEntryDTO"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lunch entries in eaten order",
          "title": "Lunch"
        },
        "snacks": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DiaryEntryDTO"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Snacks entries in eaten order",
          "title": "Snacks"
        }
      },
      "required": [
        "date"
      ],
      "title": "DiaryDayDTO",
      "type": "object"
    },
    "DiaryEntryDTO": {
      "additionalProperties": false,
      "description": "One eaten serving, with the numbers as they were when it was logged.\n\nA recipe entry names its recipe and carries every number. A free-form\nentry (takeout, eating out) has no recipe: a title, calories and the\nthree macros for one portion (the other numbers, cost included, may be\nabsent = unknown), and whether the numbers are an estimate. It is never\nlinked to a prep session.",
      "properties": {
        "calories_kcal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Calories Kcal"
        },
        "carbs_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Carbs G"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost of one serving when logged, in CAD",
          "title": "Cost"
        },
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntryEstimateDTO"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form entries: present when the numbers are a guess"
        },
        "fat_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Fat G"
        },
        "fiber_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Fiber G"
        },
        "id": {
          "description": "Entry id (UUID); never changes",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "potassium_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Potassium Mg"
        },
        "protein_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Protein G"
        },
        "recipe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the recipe that was eaten; absent for a free-form entry (takeout, eating out)",
          "title": "Recipe"
        },
        "saturated_fat_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Saturated Fat G"
        },
        "session": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the prep session this serving came from; absent when not from a session",
          "title": "Session"
        },
        "sodium_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Sodium Mg"
        },
        "sugars_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per serving, when logged",
          "title": "Sugars G"
        },
        "title": {
          "description": "Recipe title when the entry was logged",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "DiaryEntryDTO",
      "type": "object"
    },
    "EntryEstimateDTO": {
      "additionalProperties": false,
      "description": "How a free-form entry's numbers were guessed (absent: they are known,\ne.g. from the menu or label).",
      "properties": {
        "assumptions": {
          "description": "What the estimate assumed (size, oil, sauce...)",
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "kcal_high": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "High end of the calories range, if given",
          "title": "Kcal High"
        },
        "kcal_low": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Low end of the calories range, if given",
          "title": "Kcal Low"
        },
        "source": {
          "description": "Typed in by hand, or estimated by AI",
          "enum": [
            "manual",
            "ai"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "EntryEstimateDTO",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "days": {
      "description": "Logged days in date order",
      "items": {
        "$ref": "#/$defs/DiaryDayDTO"
      },
      "minItems": 1,
      "title": "Days",
      "type": "array"
    },
    "week": {
      "description": "ISO week label, e.g. 2026-W42; must be a real ISO week and every day must fall inside it",
      "pattern": "^(\\d{4})-W(\\d{2})$",
      "title": "Week",
      "type": "string"
    }
  },
  "required": [
    "week",
    "days"
  ],
  "title": "DiaryWeekDTO",
  "type": "object"
}
