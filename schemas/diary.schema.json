{
  "$defs": {
    "DiaryDayDTO": {
      "additionalProperties": false,
      "properties": {
        "breakfast": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DiaryEntryDTO"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Breakfast entries in eaten order",
          "title": "Breakfast"
        },
        "date": {
          "description": "Calendar day this entry records",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "dinner": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DiaryEntryDTO"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dinner entries in eaten order",
          "title": "Dinner"
        },
        "lunch": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DiaryEntryDTO"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lunch entries in eaten order",
          "title": "Lunch"
        },
        "snacks": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DiaryEntryDTO"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Snacks entries in eaten order",
          "title": "Snacks"
        }
      },
      "required": [
        "date"
      ],
      "title": "DiaryDayDTO",
      "type": "object"
    },
    "DiaryEntryDTO": {
      "oneOf": [
        {
          "$ref": "#/$defs/RecipeEntryDTO"
        },
        {
          "$ref": "#/$defs/TakeoutEntryDTO"
        }
      ]
    },
    "RecipeEntryDTO": {
      "additionalProperties": false,
      "description": "A serving of a catalog recipe: every number frozen when it was logged\n(#107), and the prep session it came from, if any.",
      "properties": {
        "calories_kcal": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Calories Kcal",
          "type": "number"
        },
        "carbs_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Carbs G",
          "type": "number"
        },
        "cost": {
          "description": "Cost of one serving, in CAD",
          "minimum": 0,
          "title": "Cost",
          "type": "number"
        },
        "fat_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Fat G",
          "type": "number"
        },
        "fiber_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Fiber G",
          "type": "number"
        },
        "id": {
          "description": "Entry id (UUID); never changes",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "potassium_mg": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Potassium Mg",
          "type": "number"
        },
        "protein_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Protein G",
          "type": "number"
        },
        "recipe": {
          "description": "Id of the recipe that was eaten",
          "title": "Recipe",
          "type": "string"
        },
        "saturated_fat_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Saturated Fat G",
          "type": "number"
        },
        "session": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the prep session this serving came from; absent when not from a session",
          "title": "Session"
        },
        "sodium_mg": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Sodium Mg",
          "type": "number"
        },
        "sugars_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Sugars G",
          "type": "number"
        },
        "title": {
          "description": "Title when logged",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "calories_kcal",
        "protein_g",
        "fat_g",
        "carbs_g",
        "recipe",
        "cost",
        "fiber_g",
        "saturated_fat_g",
        "sugars_g",
        "sodium_mg",
        "potassium_mg"
      ],
      "title": "RecipeEntryDTO",
      "type": "object"
    },
    "TakeoutEntryDTO": {
      "additionalProperties": false,
      "description": "A meal that isn't a recipe (takeout, eating out): calories and macros\nas typed or estimated; cost and the minor nutrients only when known\n(absent = unknown). Never linked to a prep session: it has no field for\none.",
      "properties": {
        "calories_kcal": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Calories Kcal",
          "type": "number"
        },
        "carbs_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Carbs G",
          "type": "number"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost in CAD; absent when unknown",
          "title": "Cost"
        },
        "fat_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Fat G",
          "type": "number"
        },
        "fiber_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If known",
          "title": "Fiber G"
        },
        "id": {
          "description": "Entry id (UUID); never changes",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "potassium_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If known",
          "title": "Potassium Mg"
        },
        "protein_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Protein G",
          "type": "number"
        },
        "saturated_fat_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If known",
          "title": "Saturated Fat G"
        },
        "sodium_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If known",
          "title": "Sodium Mg"
        },
        "sugars_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If known",
          "title": "Sugars G"
        },
        "title": {
          "description": "Title when logged",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "calories_kcal",
        "protein_g",
        "fat_g",
        "carbs_g"
      ],
      "title": "TakeoutEntryDTO",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "days": {
      "description": "Logged days in date order",
      "items": {
        "$ref": "#/$defs/DiaryDayDTO"
      },
      "minItems": 1,
      "title": "Days",
      "type": "array"
    },
    "week": {
      "description": "ISO week label, e.g. 2026-W42; must be a real ISO week and every day must fall inside it",
      "pattern": "^(\\d{4})-W(\\d{2})$",
      "title": "Week",
      "type": "string"
    }
  },
  "required": [
    "week",
    "days"
  ],
  "title": "DiaryWeekDTO",
  "type": "object"
}
