{
  "$defs": {
    "BinnedEntryDTO": {
      "additionalProperties": false,
      "description": "A portion thrown away, and the day it went to the bin.",
      "properties": {
        "binned": {
          "description": "Day the portion was binned",
          "format": "date",
          "title": "Binned",
          "type": "string"
        },
        "calories_kcal": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Calories Kcal",
          "type": "number"
        },
        "carbs_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Carbs G",
          "type": "number"
        },
        "cost": {
          "description": "Cost of one serving, in CAD",
          "minimum": 0,
          "title": "Cost",
          "type": "number"
        },
        "fat_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Fat G",
          "type": "number"
        },
        "fiber_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Fiber G",
          "type": "number"
        },
        "id": {
          "description": "Entry id (UUID); never changes",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "planned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True when the planner placed this serving and nobody has accepted or moved it yet; absent otherwise",
          "title": "Planned"
        },
        "potassium_mg": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Potassium Mg",
          "type": "number"
        },
        "protein_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Protein G",
          "type": "number"
        },
        "recipe": {
          "description": "Id of the recipe that was eaten",
          "title": "Recipe",
          "type": "string"
        },
        "saturated_fat_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Saturated Fat G",
          "type": "number"
        },
        "session": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the prep session this serving came from; absent when not from a session",
          "title": "Session"
        },
        "sodium_mg": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Sodium Mg",
          "type": "number"
        },
        "sugars_g": {
          "description": "Per serving, when logged",
          "minimum": 0,
          "title": "Sugars G",
          "type": "number"
        },
        "title": {
          "description": "Title when logged",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "calories_kcal",
        "protein_g",
        "fat_g",
        "carbs_g",
        "recipe",
        "cost",
        "fiber_g",
        "saturated_fat_g",
        "sugars_g",
        "sodium_mg",
        "potassium_mg",
        "binned"
      ],
      "title": "BinnedEntryDTO",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Portions thrown away, ``diary/bin.yaml``.",
  "properties": {
    "meals": {
      "description": "Portions of prep sessions that were thrown away; each names its session",
      "items": {
        "$ref": "#/$defs/BinnedEntryDTO"
      },
      "title": "Meals",
      "type": "array"
    }
  },
  "title": "BinDTO",
  "type": "object"
}
